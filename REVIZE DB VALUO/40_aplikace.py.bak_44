# -*- coding: utf-8 -*-
"""
40_aplikace.py — mapová aplikace nad databází vkladů
====================================================
Databáze: VALUO        Krok: 40        Datum: 24. 10. 2026

K čemu to je
------------
Místní webová aplikace: mapa všech vkladů v databázi, filtr podle druhu
nemovitosti, barevné odlišení jednotkových cen, karta po kliknutí,
srovnávací soubor vybraných vzorků a jeho export do jednoho dokumentu Wordu.

Je to nástavba nad tím, co už existuje:
    35_export_word.py  — datová vrstva a export do Wordu
    37_karta_html.py   — vykreslení karty vkladu
    39_mapa_data.sql   — tabulka Valuo_mapa, ze které mapa čte

Spuštění
--------
    python 40_aplikace.py
    python 40_aplikace.py --port 8080 --bez-prohlizece

Pak http://localhost:8000/.

Předpoklad
----------
Naplněná Valuo_mapa:
    python 38_prepocty.py            # karty po vkladech, ta dlouhá část
    EXEC dbo.sp_prepocet_mapy        # nebo python 38_prepocty.py --krok mapa

Bez toho je mapa prázdná. Aplikace to na úvodní obrazovce napíše.

Proč vlastní server a ne jen soubor
-----------------------------------
Prohlížeč sám na SQL Server nedosáhne a soubor otevřený přes file:// má
zakázané volání cizích serverů, takže by se nenačetly ani mapové vrstvy.
Server tady drží spojení do databáze, odpovídá na dotazy mapy a umí
spustit export do Wordu — tedy i to tlačítko Export, které ve statické
kartě chybělo.

Stav rozpracovanosti
--------------------
První verze. Hotové: mapa, vrstvy, filtr druhu, barevná škála cen, rozpad
bytového domu na jednotky, karta, srovnávací soubor, export do Wordu.
Zatím chybí: poznámky k nemovitostem, kreslení polygonů parcel přímo
v přehledové mapě (zatím jen body), hledání podle adresy.

Závislosti: jen standardní knihovna plus to, co už mají 35 a 37.
"""

import argparse
import datetime
import decimal
import importlib.util
import io
import json
import os
import re
import sys
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs, unquote

ZDE = os.path.dirname(os.path.abspath(__file__))


def _nacti(jmeno, nazev_modulu):
    cesta = os.path.join(ZDE, jmeno)
    if not os.path.exists(cesta):
        raise SystemExit(f"Vedle tohoto skriptu chybí {jmeno}.")
    spec = importlib.util.spec_from_file_location(nazev_modulu, cesta)
    modul = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(modul)
    return modul


sys.argv_puvodni, sys.argv = sys.argv, [sys.argv[0]]   # importované skripty mají vlastní argparse
EX = _nacti("35_export_word.py", "export_word")
K37 = _nacti("37_karta_html.py", "karta_html")
sys.argv = sys.argv_puvodni

