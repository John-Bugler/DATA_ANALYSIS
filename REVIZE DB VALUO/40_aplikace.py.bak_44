SQL_OBNOV_REGISTR = """
/* Po zápisu ručně zadané plochy se registr pro ten jeden vklad obnoví hned,
   aby karta i export do Wordu ukazovaly totéž co aplikace. Celý přepočet
   (sp_prepocet_ploch) se kvůli jednomu vkladu pouštět nemusí. */
MERGE dbo.Valuo_plochy AS cil
USING (SELECT r.cislo_vkladu, r.plocha_rucne, r.plocha_rucne_zdroj
       FROM dbo.Valuo_vklad_rucne r
       WHERE r.cislo_vkladu = :v AND r.plocha_rucne > 0) AS z
   ON cil.cislo_vkladu = z.cislo_vkladu AND cil.zdroj = 'RUCNE'
WHEN MATCHED THEN UPDATE SET cil.plocha = z.plocha_rucne,
     cil.poznamka = z.plocha_rucne_zdroj, cil.kdy = SYSDATETIME()
WHEN NOT MATCHED BY TARGET THEN
     INSERT (cislo_vkladu, zdroj, plocha, platny, poznamka, kdy)
     VALUES (z.cislo_vkladu, 'RUCNE', z.plocha_rucne, 1, z.plocha_rucne_zdroj, SYSDATETIME())
WHEN NOT MATCHED BY SOURCE AND cil.cislo_vkladu = :v AND cil.zdroj = 'RUCNE'
     THEN DELETE;
"""

