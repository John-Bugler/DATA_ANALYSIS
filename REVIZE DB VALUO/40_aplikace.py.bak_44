SQL_BODY = """
SELECT TOP (:limit)
       m.cislo_vkladu, m.lat, m.lon, m.shluk_id, m.kategorie, m.druh,
       m.jednotka_oznaceni, m.adresa, m.kat_uzemi, m.obec, m.rok,
       m.cena_Kc, m.cena_m2, m.zaklad_ceny, m.plocha, m.parcel_celkem, m.ma_kartu
FROM dbo.Valuo_mapa m
LEFT JOIN dbo.Valuo_vklad_rucne r ON r.cislo_vkladu = m.cislo_vkladu
WHERE m.lat BETWEEN :jih AND :sever
  AND m.lon BETWEEN :zapad AND :vychod
  AND (:kat = '' OR m.kategorie = :kat)
  AND (:rok_od IS NULL OR m.rok >= :rok_od)
  AND (:bez_ceny = 1 OR m.cena_m2 IS NOT NULL)
  /* Co vklad obsahuje — tři nezávislé příznaky. Vklad s domem,
     garáží a zahradou vyhoví budově i parcele; prázdný výběr
     neomezuje nic. */
  AND (:obs_vse = 1
       OR (:obs_budova = 1 AND m.ma_budovu = 1)
       OR (:obs_jednotka = 1 AND m.ma_jednotku = 1)
       OR (:obs_parcela = 1 AND m.ma_parcelu = 1))
  AND (:druh = '' OR m.druh = :druh)
  AND (:konstrukce = '' OR m.konstrukce = :konstrukce)
  AND (:stavba_od IS NULL OR m.rok_stavby >= :stavba_od)
  AND (:stavba_do IS NULL OR m.rok_stavby <= :stavba_do)
  /* Vzorky, které znalec označil za nepoužitelné, se ve výchozím
     stavu nezobrazují — do porovnání stejně nepatří. */
  AND (:nepouzitelne = 1 OR ISNULL(r.pouzitelnost, '') <> 'nepouzitelny')
  /* Jen k doplnění: co ještě čeká na znalcovo rozhodnutí. */
  AND (:doplnit = ''
       OR (:doplnit = 'plocha' AND r.plocha_rucne IS NULL
           AND (m.cena_m2 IS NULL OR m.nalez_plocha_cely_dum = 1))
       OR (:doplnit = 'pouzitelnost' AND r.pouzitelnost IS NULL)
       OR (:doplnit = 'nalez' AND m.nalez_plocha_cely_dum = 1
           AND r.cislo_vkladu IS NULL)
       OR (:doplnit = 'posun' AND m.nalez_plocha_posun = 1
           AND r.plocha_rucne IS NULL))
ORDER BY CASE WHEN m.cena_m2 IS NULL THEN 1 ELSE 0 END, m.cena_Kc DESC
"""

