SQL_MEZE = """
SELECT kategorie,
       COUNT(*) AS pocet,
       MIN(cena_m2) AS nej_niz,
       MAX(cena_m2) AS nej_vys,
       MAX(CASE WHEN p = 1 THEN cena_m2 END) AS k20,
       MAX(CASE WHEN p = 2 THEN cena_m2 END) AS k40,
       MAX(CASE WHEN p = 3 THEN cena_m2 END) AS k60,
       MAX(CASE WHEN p = 4 THEN cena_m2 END) AS k80
FROM (SELECT kategorie, cena_m2,
             NTILE(5) OVER (PARTITION BY kategorie ORDER BY cena_m2) AS p
      FROM dbo.Valuo_mapa WHERE cena_m2 IS NOT NULL) x
GROUP BY kategorie
"""

