    "# --- 1 --- PRIPOJENI K DB + NASTAVENI SQL DOTAZU #\n",
    "\n",
    "import pandas as pd\n",
    "from sqlalchemy import create_engine, text\n",
    "import urllib.parse\n",
    "    \n",
    "# Připojení k DB Valuo pomocí SQLAlchemy\n",
    "params_conn = urllib.parse.quote_plus(\n",
    "        \"Driver={ODBC Driver 17 for SQL Server};\"\n",
    "        \"Server=192.168.11.133;\"\n",
    "        \"Database=VALUO;\"\n",
    "        \"UID=jete_lokalni_pripojeni_valuo;\"\n",
    "        \"PWD=jete.666;\"\n",
    "    )\n",
    "connection_url = f\"mssql+pyodbc:///?odbc_connect={params_conn}\"\n",
    "\n",
    "#params_conn = urllib.parse.quote_plus(\n",
    "#        \"Driver={ODBC Driver 17 for SQL Server};\"\n",
    "#        \"Server=RYZEN9;\"\n",
    "#        \"Database=VALUO;\"\n",
    "#        \"Trusted_Connection=yes;\"\n",
    "#    )\n",
    "#connection_url = f\"mssql+pyodbc:///?odbc_connect={params_conn}\"\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "engine = create_engine(connection_url)\n",
    "\n",
    "with engine.connect() as conn:\n",
    "    df_input = pd.read_sql(text(query), conn)\n",
    "\n",
    "# Zobrazení výsledku pro kontrolu\n",
    "print(df_input.head())"
   ]
